{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cccp",
  "main": "src/worker.js",
  "compatibility_date": "2024-09-23",
  "routes": [
    {
      "pattern": "cccp.2lp.in",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
